<scheme name="Matugen Dark" version="142" parent_scheme="Darcula">
  <option name="CARET_COLOR" value="{{colors.primary.dark.hex_stripped}}" />
  <option name="CARET_ROW_COLOR" value="{{colors.surface_container_high.dark.hex_stripped}}" />
  <option name="CONSOLE_BACKGROUND_KEY" value="{{colors.background.dark.hex_stripped}}" />
  <option name="CONSOLE_FOREGROUND_KEY" value="{{colors.on_background.dark.hex_stripped}}" />
  <option name="CONSOLE_LINE_SEPARATOR_COLOR" value="{{colors.outline.dark.hex_stripped}}" />
  <attributes>
    <option name="TEXT">
      <value>
        <option name="FOREGROUND" value="{{colors.on_background.dark.hex_stripped}}" />
        <option name="BACKGROUND" value="{{colors.background.dark.hex_stripped}}" />
      </value>
    </option>
    <option name="DEFAULT_STRING">
      <value>
        <option name="FOREGROUND" value="{{colors.tertiary.dark.hex_stripped}}" />
      </value>
    </option>
    <option name="DEFAULT_NUMBER">
      <value>
        <option name="FOREGROUND" value="{{colors.secondary.dark.hex_stripped}}" />
      </value>
    </option>
    <option name="DEFAULT_KEYWORD">
      <value>
        <option name="FOREGROUND" value="{{colors.primary.dark.hex_stripped}}" />
        <option name="FONT_TYPE" value="1" />
      </value>
    </option>
    <option name="DEFAULT_FUNCTION_DECLARATION">
      <value>
        <option name="FOREGROUND" value="{{colors.primary_container.dark.hex_stripped}}" />
      </value>
    </option>
    <option name="DEFAULT_CLASS_NAME">
      <value>
        <option name="FOREGROUND" value="{{colors.tertiary_container.dark.hex_stripped}}" />
      </value>
    </option>
    <option name="DEFAULT_INVALID">
      <value>
        <option name="FOREGROUND" value="{{colors.error.dark.hex_stripped}}" />
        <option name="EFFECT_COLOR" value="{{colors.error.dark.hex_stripped}}" />
        <option name="EFFECT_TYPE" value="2" />
      </value>
    </option>
  </attributes>
</scheme>
